{
  "name": "@nshiab/setup-data-project",
  "version": "4.0.6",
  "description": "Quickly kick off a project using simple-data-analysis-core, simple-data-analysis, and journalism libraries.",
  "license": "MIT",
  "repository": "https://github.com/nshiab/setup-data-project",
  "bin": {
    "sda-run": "./dist/sda.mjs",
    "setup-data-project": "./dist/main.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "cache-plot-docs": "node scripts/cachePlotDocs.ts",
    "fix": "vp check --fix",
    "all-tests": "vp check && vp test && vp pack",
    "preversion": "node scripts/check-release-branch.ts && npm run all-tests",
    "postversion": "git push --atomic origin HEAD \"v$npm_package_version\"",
    "patch": "npm version patch",
    "minor": "npm version minor",
    "major": "npm version major"
  },
  "dependencies": {
    "@clack/prompts": "^1.3.0",
    "tar": "^7.5.11"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "vite-plus": "1.2.0"
  },
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  }
}
